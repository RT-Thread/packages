    menu "Agent Tools Configuration"

        config PKG_AGENT_TOOL_LOOP_MAX
            int "Max tool call rounds per request"
            default 6
            range 1 32
            help
                How many rounds of tool calls one user request may run.
                Each round sends the model a request, executes the tools it
                asks for, and feeds the results back. When the limit is hit,
                the framework sends one more request without tools and asks
                the model for a final text answer.

                Raise it when a task needs more steps, for example a desktop
                task that has to work through several windows in turn. Every
                extra round costs one more LLM request, so a larger value
                costs more time and tokens.

        menu "Agent Tool: Mqtt Client"

            config PKG_AGENT_TOOL_MQTT_ENABLE
                bool "Enable MQTT client tool"
                select PKG_USING_PAHOMQTT
                # 工具依赖 paho 的 pipe 模式（UDP 模式不提供 publish/subscribe 接口）。
                # 注意：PAHOMQTT_PIPE_MODE / PAHOMQTT_UDP_MODE 在 paho 的 Kconfig 里是
                # 同一个 choice 的成员，select 对 choice 成员无效（kconfiglib 会报
                # "select/imply has no effect on choice symbols"），所以这里不能 select，
                # 原来那句 select PAHOMQTT_PIPE_MODE 实际不起作用。请在 paho menuconfig
                # 里手动确认 "MQTT mode" 选的是 Pipe mode；若选成 UDP，
                # tool_mqtt.h 会在编译期直接 #error 提示。
                default n
                help
                    Enable the MQTT tool set for the agent:
                      * mqtt_connect    : connect to the broker (idempotent)
                      * mqtt_disconnect : disconnect from the broker, keeping the
                                          subscription table so a later connect
                                          re-subscribes automatically
                      * mqtt_publish    : publish a command to a topic
                                          (checks the connection first)
                      * mqtt_subscribe  : subscribe/unsubscribe topics at runtime
                                          (delivery mode: filter/auto/poll)
                      * mqtt_rule       : threshold rules, only wake the agent when out of range
                      * mqtt_history    : summarize recent messages/payloads + numeric
                                          min/max/avg, so the agent can assess the recent
                                          situation (read-only)
                      * mqtt_receive    : consume buffered messages on demand

                    Requires paho-mqtt in PIPE mode: select it manually in the
                    paho menuconfig ("MQTT mode" -> Pipe mode), it cannot be
                    selected from here because it is a choice member.

                    IMPORTANT (paho side, must be set in the paho menuconfig):
                      * PKG_PAHOMQTT_SUBSCRIBE_HANDLERS >= PKG_AGENT_TOOL_MQTT_MAX_SUB_TOPICS
                        (default 4; with the paho default of 1 only one topic can be subscribed)
                      * RT_PKG_MQTT_THREAD_STACK_SIZE >= 8192
                        (the paho worker opens "/dev/MQTTn" through DFS, whose path
                         resolution allocates ~12KB and needs stack; a 4KB stack
                         overflows it, corrupts heap metadata and hangs the system)

            if PKG_AGENT_TOOL_MQTT_ENABLE

                menu "MQTT Connection"

                    config PKG_AGENT_TOOL_MQTT_BROKER_URL
                        string "MQTT broker URL"
                        default "tcp://broker.emqx.io:1883"
                        help
                            Broker URL passed to paho. Only "tcp://host:port" or
                            "ssl://host:port" are accepted by paho (NOT "mqtt://").

                    config PKG_AGENT_TOOL_MQTT_CLIENT_ID
                        string "MQTT client ID"
                        default "rt-thread-agent"
                        help
                            MQTT client ID. Two devices sharing one ID will kick
                            each other's session off the broker.

                    config PKG_AGENT_TOOL_MQTT_USERNAME
                        string "MQTT username"
                        default ""

                    config PKG_AGENT_TOOL_MQTT_PASSWORD
                        string "MQTT password"
                        default ""

                    config PKG_AGENT_TOOL_MQTT_WILLMSG
                        string "MQTT will message"
                        default "Goodbye from RT-Thread Agent"
                        help
                            Last-will payload, published by the broker on the
                            publish topic when the client drops unexpectedly.

                    config PKG_AGENT_TOOL_MQTT_KEEPALIVE_SEC
                        int "MQTT keepalive interval (s)"
                        default 60
                        range 10 600

                    config PKG_AGENT_TOOL_MQTT_QOS
                        int "MQTT QoS level"
                        default 1
                        range 0 2
                        help
                            Reserved for compatibility: paho in PIPE mode only
                            implements QoS1, and the agent MQTT tool always uses
                            QoS1 regardless of this value.

                endmenu

                menu "MQTT Topics & Delivery"

                    config PKG_AGENT_TOOL_MQTT_PUB_TOPIC
                        string "Default publish topic"
                        default "agent/pub"
                        help
                            Topic used when a publish call does not specify one.

                    config PKG_AGENT_TOOL_MQTT_SUB_TOPIC
                        string "Default subscribe topic"
                        default "agent/sub"
                        help
                            Topic subscribed automatically when the client starts.

                    choice PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_SEL
                        prompt "Default topic delivery mode"
                        default PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_FILTER
                        help
                            How messages of subscribed topics are delivered to the agent.

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_FILTER
                            bool "filter - only advice/threshold breaches wake the agent"
                            help
                                Messages are filtered locally: the agent is only
                                woken up when a message looks like a question or
                                matches an mqtt_rule threshold. Routine data is
                                counted and kept in the per-topic history instead.

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_AUTO
                            bool "auto - forward every message"

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_POLL
                            bool "poll - never forward, fetch with mqtt_receive/mqtt_history"
                    endchoice

                    config PKG_AGENT_TOOL_MQTT_AUTO_SUB_DEFAULT
                        bool "Auto subscribe the default topic at startup"
                        default y

                endmenu

                menu "MQTT Capacity & Buffers"

                    config PKG_AGENT_TOOL_MQTT_BUF_SIZE
                        int "paho send/receive buffer size"
                        default 1024
                        range 256 8192
                        help
                            Buffer used by paho for building/parsing packets.

                    config PKG_AGENT_TOOL_MQTT_MAX_SUB_TOPICS
                        int "Max concurrent subscriptions"
                        default 4
                        range 1 16
                        help
                            Capped automatically by paho's MAX_MESSAGE_HANDLERS
                            (PKG_PAHOMQTT_SUBSCRIBE_HANDLERS).

                    config PKG_AGENT_TOOL_MQTT_MAX_RULES
                        int "Max threshold rules"
                        default 4
                        range 1 16

                    config PKG_AGENT_TOOL_MQTT_TOPIC_MAX_LEN
                        int "Topic string buffer length"
                        default 64
                        range 16 256

                    config PKG_AGENT_TOOL_MQTT_PAYLOAD_MAX_LEN
                        int "Max received payload length"
                        default 256
                        range 32 1024
                        help
                            Longer payloads are truncated and marked as truncated.

                    config PKG_AGENT_TOOL_MQTT_MAX_PUB_LEN
                        int "Max published payload length"
                        default 256
                        range 32 1024
                        help
                            Also bounded by the paho buffer and the rt_pipe size;
                            a too-long publish is rejected with an error text.

                    config PKG_AGENT_TOOL_MQTT_FIELD_MAX_LEN
                        int "Max JSON field name length (rules)"
                        default 24
                        range 8 64

                    config PKG_AGENT_TOOL_MQTT_LAST_PAYLOAD_LEN
                        int "Cached last-payload length per topic"
                        default 96
                        range 16 256
                        help
                            Last payload per subscription, shown by mqtt_tool status
                            so the agent can answer "what is the current value".

                    config PKG_AGENT_TOOL_MQTT_HISTORY_DEPTH
                        int "Recent messages kept per topic (mqtt_history)"
                        default 8
                        range 1 32
                        help
                            Per-topic ring of recent raw payloads. This is the data
                            source of the mqtt_history tool, which summarizes recent
                            readings plus numeric min/max/avg/last for the agent -
                            including messages that were filtered locally and never
                            sent to the LLM. mqtt_history is read-only; mqtt_receive
                            consumes the separate buffered-message window.

                    config PKG_AGENT_TOOL_MQTT_HISTORY_PAYLOAD_LEN
                        int "Payload length kept in history"
                        default 128
                        range 16 512
                        help
                            Longer payloads are stored truncated in the history.

                    config PKG_AGENT_TOOL_MQTT_RX_QUEUE_DEPTH
                        int "Receive queue depth (callback -> rx thread)"
                        default 16
                        range 2 64
                        help
                            Messages queue here while the agent is busy; the oldest
                            is dropped when full.

                    config PKG_AGENT_TOOL_MQTT_POLL_DEPTH
                        int "Rolling window depth"
                        default 8
                        range 1 32
                        help
                            Ring buffer for poll mode and for locally filtered
                            messages, consumed on demand with mqtt_receive.

                endmenu

                menu "MQTT Throttling & Alerts"

                    config PKG_AGENT_TOOL_MQTT_INJECT_MIN_INTERVAL_MS
                        int "Min interval between two agent injections (ms)"
                        default 1000
                        range 0 60000
                        help
                            Guards the LLM endpoint: requests sent too frequently
                            get reset by the server/proxy, which shows up as
                            "mbedtls_client_read data error -0x4c" plus
                            "chat: POST failed http status=-76".

                    config PKG_AGENT_TOOL_MQTT_INJECT_BATCH_MAX
                        int "Max messages merged into one injection"
                        default 5
                        range 1 16

                    config PKG_AGENT_TOOL_MQTT_BUSY_WAIT_MS
                        int "Max wait for an idle agent before buffering (ms)"
                        default 180000
                        range 0 900000
                        help
                            While the agent is handling a previous round, incoming
                            messages wait (and are merged) instead of interrupting
                            it. On timeout they go to the rolling window instead.

                    config PKG_AGENT_TOOL_MQTT_ALERT_COOLDOWN_MS
                        int "Alert cooldown per rule (ms)"
                        default 60000
                        range 0 3600000
                        help
                            A rule alerts on the rising edge, and again after this
                            cooldown while it stays out of range.

                    config PKG_AGENT_TOOL_MQTT_LOCK_WAIT_MS
                        int "State lock wait timeout (ms)"
                        default 1000
                        range 1 10000
                        help
                            The tool never waits forever on its state lock, so a
                            stuck peer cannot freeze the agent loop or MSH.

                endmenu

                menu "MQTT Timeouts & Thread"

                    config PKG_AGENT_TOOL_MQTT_CONNECT_WAIT_MS
                        int "Wait for connection before publish (ms)"
                        default 3000
                        range 0 60000

                    config PKG_AGENT_TOOL_MQTT_SUB_WAIT_MS
                        int "Wait for subscription to take effect (ms)"
                        default 3000
                        range 0 60000

                    config PKG_AGENT_TOOL_MQTT_RX_THREAD_STACK
                        int "RX thread stack size"
                        default 3072
                        range 2048 16384

                    config PKG_AGENT_TOOL_MQTT_RX_THREAD_PRIO
                        int "RX thread priority"
                        default 15
                        range 1 31
                        help
                            Lower number = higher priority.
                            RT_THREAD_PRIORITY_MAX defaults to 32, so keep this in
                            1..31: a priority >= RT_THREAD_PRIORITY_MAX makes
                            rt_thread_create() trip its assertion (the previous
                            range 1 254 allowed unusable values).

                endmenu

            endif

        endmenu

        menu "Agent Tool: Device Framework"

            # 设备工具按设备类拆成一个目录一个 .c：core 是通用层，其余每类一个模块。
            # 每个模块文件自己用 #ifdef PKG_AGENT_TOOL_DEVICE_XXX 包住全文，并用
            # AGENT_TOOL_MODULE_EXPORT 登记到模块表，所以关掉某个模块 = 不编译该文件，
            # 注册表和工具列表里自然没有它，不需要改中心文件。
            config PKG_AGENT_TOOL_DEVICE
                bool "Enable device framework tools"
                depends on RT_USING_DEVICE
                default n
                help
                    Let the agent drive peripherals through the RT-Thread device framework.
                    Turn on the generic layer (core) first, then pick the device classes the
                    project actually has drivers for.

            if PKG_AGENT_TOOL_DEVICE

                config PKG_AGENT_TOOL_DEVICE_CORE
                    bool "Generic layer (device_list/info/open/close/read/write/control)"
                    default y
                    help
                        The class-independent tools over rt_device_*. Keep this on: every
                        other module tells the model to call device_list first to get exact
                        device names, and the console/read-only guards live here.

                config PKG_AGENT_TOOL_DEVICE_PIN
                    bool "GPIO pin tools (pin_mode/pin_write/pin_read)"
                    depends on RT_USING_PIN
                    default y
                    help
                        Uses the global pin controller installed by rt_pin_attach_irq's
                        companion driver, so a pin driver must be registered; pin numbers
                        accept 12345 or the "P3.4" style name.

                config PKG_AGENT_TOOL_DEVICE_PWM
                    bool "PWM tools (pwm_set/get/enable/disable)"
                    depends on RT_USING_PWM
                    default y
                    help
                        Period and duty are nanoseconds on a 'pwm0' class pwm device.
                        With no PWM driver attached, device_list shows no pwm device and
                        these tools report that instead of guessing a channel.

                config PKG_AGENT_TOOL_DEVICE_ADC
                    bool "ADC tools (adc_read)"
                    depends on RT_USING_ADC && !RT_USING_ADC_V2
                    default y
                    help
                        One shot read: enable the channel, return raw plus millivolt, then
                        disable again. Needs the v1 ADC framework; ADC V2 replaces the
                        channel API with batch streams, so this module compiles out there.

                config PKG_AGENT_TOOL_DEVICE_DAC
                    bool "DAC tools (dac_write/dac_enable/dac_disable)"
                    depends on RT_USING_DAC
                    default y
                    help
                        Values are raw codes; the tool clamps them against the resolution
                        reported by the driver before writing.

                config PKG_AGENT_TOOL_DEVICE_I2C
                    bool "I2C tools (i2c_write/read/writeread)"
                    depends on RT_USING_I2C
                    default y
                    help
                        Talks to a 7-bit or 10-bit address on an i2cbus device such as
                        'i2c1'. writeread is the combined transaction most register-map
                        chips need.

                config PKG_AGENT_TOOL_DEVICE_SPI
                    bool "SPI tools (spi_configure/spi_transfer)"
                    depends on RT_USING_SPI
                    default y
                    help
                        These act on SPI slave devices (class spidevice, e.g. 'spi10'),
                        not on the bus itself; a bus needs its driver attached first.

                config PKG_AGENT_TOOL_DEVICE_SENSOR
                    bool "Sensor tools (sensor_read/info/control)"
                    depends on RT_USING_SENSOR && !RT_USING_SENSOR_V2
                    default y
                    help
                        Reads struct rt_sensor_data through rt_device_read and decodes
                        data.type into a value with its unit. Sensor framework v2 has a
                        different frame API, so this module compiles out there.

                config PKG_AGENT_TOOL_DEVICE_LED
                    bool "LED tools (led_set/led_get/led_brightness)"
                    depends on RT_USING_LED
                    default y
                    help
                        Uses the LED framework's text protocol on the 'led0'.. char devices,
                        so the device has to be opened with device_open before use. The LED
                        framework itself sits under RT_USING_DM, so without device model this
                        module has no devices to talk to.

            endif

        endmenu

        menu "Agent Tool: MCP Client"

            config PKG_AGENT_TOOL_MCP_ENABLE
                bool "Enable MCP client tools"
                default n
                help
                    Let the agent talk to one MCP (Model Context Protocol) server
                    over Streamable HTTP. At agent startup the client runs the
                    initialize / notifications/initialized / tools/list handshake
                    and registers every remote tool into the agent tool table with
                    an "mcp_" prefix, so the model can call them like local tools.

                    The server side lives in the package mcp/ directory: a bundled
                    HTTP server plus a stdio-to-HTTP bridge for the servers Windows
                    registers through the On-Device Registry (odr.exe list) and for
                    servers started from the command line, such as Windows-MCP
                    (CursorTouch/Windows-MCP), which drives the local desktop.

                    If the server cannot be reached the agent still starts, just
                    without the remote tools.

            if PKG_AGENT_TOOL_MCP_ENABLE

                config PKG_AGENT_MCP_SERVER_URL
                    string "MCP server endpoint URL"
                    default "http://192.168.1.100:8765/mcp"
                    help
                        Full URL of the MCP endpoint, for example
                        http://192.168.1.100:8765/mcp. Use the LAN address of the
                        machine running the server from the mcp/ directory.

                config PKG_AGENT_MCP_MAX_TOOLS
                    int "Maximum number of remote tools to register"
                    default 40
                    range 1 64
                    help
                        tools/list may offer more tools than the model should see.
                        Only the first N are registered. Windows-MCP alone offers
                        20 tools, and the bundled file tools add 11 more.

                config PKG_AGENT_MCP_TIMEOUT_MS
                    int "HTTP request timeout (ms)"
                    default 30000
                    range 1000 120000

                config PKG_AGENT_MCP_RESP_BUFSZ
                    int "Response body buffer size (bytes)"
                    default 32768
                    range 2048 65536
                    help
                        Upper limit for one MCP response body, covering the
                        tools/list result and the text of a tools/call reply.
                        Raise it when tools/list does not fit. The tool table of
                        Windows-MCP plus the file tools is about 27 KB, so the
                        default only fits a small server.

            endif

        endmenu

    endmenu


    # Package source version choice
    # NOTE: currently only master branch option, extend more tag/commit later
    choice PKG_AGENT_VERSION_SEL
        prompt "Agent package source version"
        default PKG_USING_AGENT_LATEST_VERSION
        help
            Select git source version for agent package.

        config PKG_USING_AGENT_LATEST_VERSION
            bool "latest (master branch)"
    endchoice

    config PKG_AGENT_VER
        string
        default "latest" if PKG_USING_AGENT_LATEST_VERSION

