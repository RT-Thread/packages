                    choice PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_SEL
                        prompt "Default topic delivery mode"
                        default PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_FILTER
                        help
                            How messages of subscribed topics are delivered to the agent.

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_FILTER
                            bool "filter - only advice/threshold breaches wake the agent"
                            help
                                Messages are filtered locally: the agent is only
                                woken up when a message looks like a question or
                                matches an mqtt_rule threshold. Routine data is
                                counted and kept in the per-topic history instead.

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_AUTO
                            bool "auto - forward every message"

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_POLL
                            bool "poll - never forward, fetch with mqtt_receive/mqtt_history"
                    endchoice

                    config PKG_AGENT_TOOL_MQTT_AUTO_SUB_DEFAULT
                        bool "Auto subscribe the default topic at startup"
                        default y

                endmenu

                menu "MQTT Capacity & Buffers"

                    config PKG_AGENT_TOOL_MQTT_BUF_SIZE
                        int "paho send/receive buffer size"
                        default 1024
                        range 256 8192
                        help
                            Buffer used by paho for building/parsing packets.

                    config PKG_AGENT_TOOL_MQTT_MAX_SUB_TOPICS
                        int "Max concurrent subscriptions"
                        default 4
                        range 1 16
                        help
                            Capped automatically by paho's MAX_MESSAGE_HANDLERS
                            (PKG_PAHOMQTT_SUBSCRIBE_HANDLERS).

                    config PKG_AGENT_TOOL_MQTT_MAX_RULES
                        int "Max threshold rules"
                        default 4
                        range 1 16

                    config PKG_AGENT_TOOL_MQTT_TOPIC_MAX_LEN
                        int "Topic string buffer length"
                        default 64
                        range 16 256

                    config PKG_AGENT_TOOL_MQTT_PAYLOAD_MAX_LEN
                        int "Max received payload length"
                        default 256
                        range 32 1024
                        help
                            Longer payloads are truncated and marked as truncated.

                    config PKG_AGENT_TOOL_MQTT_MAX_PUB_LEN
                        int "Max published payload length"
                        default 256
                        range 32 1024
                        help
                            Also bounded by the paho buffer and the rt_pipe size;
                            a too-long publish is rejected with an error text.

                    config PKG_AGENT_TOOL_MQTT_FIELD_MAX_LEN
                        int "Max JSON field name length (rules)"
                        default 24
                        range 8 64

                    config PKG_AGENT_TOOL_MQTT_LAST_PAYLOAD_LEN
                        int "Cached last-payload length per topic"
                        default 96
                        range 16 256
                        help
                            Last payload per subscription, shown by mqtt_tool status
                            so the agent can answer "what is the current value".

                    config PKG_AGENT_TOOL_MQTT_HISTORY_DEPTH
                        int "Recent messages kept per topic (mqtt_history)"
                        default 8
                        range 1 32
                        help
                            Per-topic ring of recent raw payloads. This is the data
                            source of the mqtt_history tool, which summarizes recent
                            readings plus numeric min/max/avg/last for the agent -
                            including messages that were filtered locally and never
                            sent to the LLM. mqtt_history is read-only; mqtt_receive
                            consumes the separate buffered-message window.

                    config PKG_AGENT_TOOL_MQTT_HISTORY_PAYLOAD_LEN
                        int "Payload length kept in history"
                        default 128
                        range 16 512
                        help
                            Longer payloads are stored truncated in the history.

                    config PKG_AGENT_TOOL_MQTT_RX_QUEUE_DEPTH
                        int "Receive queue depth (callback -> rx thread)"
                        default 16
                        range 2 64
                        help
                            Messages queue here while the agent is busy; the oldest
                            is dropped when full.

                    config PKG_AGENT_TOOL_MQTT_POLL_DEPTH
                        int "Rolling window depth"
                        default 8
                        range 1 32
                        help
                            Ring buffer for poll mode and for locally filtered
                            messages, consumed on demand with mqtt_receive.

                endmenu

                menu "MQTT Throttling & Alerts"

                    config PKG_AGENT_TOOL_MQTT_INJECT_MIN_INTERVAL_MS
                        int "Min interval between two agent injections (ms)"
                        default 1000
                        range 0 60000
                        help
                            Guards the LLM endpoint: requests sent too frequently
                            get reset by the server/proxy, which shows up as
                            "mbedtls_client_read data error -0x4c" plus
                            "chat: POST failed http status=-76".

                    config PKG_AGENT_TOOL_MQTT_INJECT_BATCH_MAX
                        int "Max messages merged into one injection"
                        default 5
                        range 1 16

                    config PKG_AGENT_TOOL_MQTT_BUSY_WAIT_MS
                        int "Max wait for an idle agent before buffering (ms)"
                        default 180000
                        range 0 900000
                        help
                            While the agent is handling a previous round, incoming
                            messages wait (and are merged) instead of interrupting
                            it. On timeout they go to the rolling window instead.

                    config PKG_AGENT_TOOL_MQTT_ALERT_COOLDOWN_MS
                        int "Alert cooldown per rule (ms)"
                        default 60000
                        range 0 3600000
                        help
                            A rule alerts on the rising edge, and again after this
                            cooldown while it stays out of range.

                    config PKG_AGENT_TOOL_MQTT_LOCK_WAIT_MS
                        int "State lock wait timeout (ms)"
                        default 1000
                        range 1 10000
                        help
                            The tool never waits forever on its state lock, so a
                            stuck peer cannot freeze the agent loop or MSH.

                endmenu

                menu "MQTT Timeouts & Thread"

                    config PKG_AGENT_TOOL_MQTT_CONNECT_WAIT_MS
                        int "Wait for connection before publish (ms)"
                        default 3000
                        range 0 60000

                    config PKG_AGENT_TOOL_MQTT_SUB_WAIT_MS
                        int "Wait for subscription to take effect (ms)"
                        default 3000
                        range 0 60000

                    config PKG_AGENT_TOOL_MQTT_RX_THREAD_STACK
                        int "RX thread stack size"
                        default 3072
                        range 2048 16384

                    config PKG_AGENT_TOOL_MQTT_RX_THREAD_PRIO
                        int "RX thread priority"
                        default 15
                        range 1 31
                        help
                            Lower number = higher priority.
                            RT_THREAD_PRIORITY_MAX defaults to 32, so keep this in
                            1..31: a priority >= RT_THREAD_PRIORITY_MAX makes
                            rt_thread_create() trip its assertion (the previous
                            range 1 254 allowed unusable values).

                endmenu

            endif

        endmenu

    endmenu


    # Package source version choice
    # NOTE: currently only master branch option, extend more tag/commit later
    choice PKG_AGENT_VERSION_SEL
        prompt "Agent package source version"
        default PKG_USING_AGENT_LATEST_VERSION
        help
            Select git source version for agent package.

        config PKG_USING_AGENT_LATEST_VERSION
            bool "latest (master branch)"
    endchoice

    config PKG_AGENT_VER
        string
        default "latest" if PKG_USING_AGENT_LATEST_VERSION

endif