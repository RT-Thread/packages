# Kconfig file for package ms-probe
menuconfig PKG_USING_MS_PROBE
    bool "ms-probe: Microscope fault diagnostics, backtrace and coredump"
    default n
    help
        GPL-2.0 / commercial dual-licensed development diagnostics.
        Run pkgs --update after selecting the package, then open menuconfig
        again to configure Scope, backtrace, coredump and BSP-specific options.
        Disable this package and Fault injection in production builds.

if PKG_USING_MS_PROBE

    config PKG_MS_PROBE_PATH
        string
        default "/packages/tools/ms-probe"

    choice
        prompt "Version"
        default PKG_USING_MS_PROBE_LATEST_VERSION

        config PKG_USING_MS_PROBE_LATEST_VERSION
            bool "latest"
    endchoice

    config PKG_MS_PROBE_VER
        string
        default "latest" if PKG_USING_MS_PROBE_LATEST_VERSION

    # Optional until pkgs --update downloads the package into the BSP.
    osource "packages/ms-probe-latest/Kconfig.options"

endif
