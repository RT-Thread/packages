# Kconfig file for package Agent
menuconfig PKG_USING_AGENT
    bool "Lightweight Agent software for RT-Thread"
    select PKG_USING_CJSON
    select PKG_USING_WEBCLIENT
    select PKG_USING_MBEDTLS
    select PKG_USING_MBEDTLS_DIGICERT_ROOT_CA
    select PKG_USING_MBEDTLS_CLOBALSIGN_ROOT_CA
    select RT_USING_ULOG

    # 完整版 vsnprintf（%f/%e/%g、long long）的来源。判定依据是「内核是否已经
    # 定义 rt_vsnprintf 符号」，而不是单纯的内核版本号：
    #
    #   * RT_KLIBC_USING_LIBC_VSNPRINTF = n（默认）
    #       klibc 会编译 rt_vsnprintf_std.c 或 rt_vsnprintf_tiny.c，两者都是强符号
    #       int rt_vsnprintf(...) -> 内核已定义该符号
    #   * RT_KLIBC_USING_LIBC_VSNPRINTF = y
    #       klibc 直接调用 libc 的 vsnprintf，内核不再定义该符号
    #
    # 所以「内核已定义」时再启用 pkgs/rt_vsnprintf_full 必然重复定义，链接报
    #     multiple definition of `rt_vsnprintf'
    # 注意 RT-Thread 4.1 起 klibc 就已经是 std/tiny 两套实现，所以只按
    # RT_VERSION_MAJOR < 5 判断会误选（这正是 4.1.x 上重复定义的原因）。
    #
    #   * 但内核的 tiny 实现（RT_KLIBC_USING_VSNPRINTF_STANDARD = n）只是「符号存在」，
    #     %f/%e/%g 会吃掉参数而不输出内容（见 rt_vsnprintf_tiny.c 的 case 'f'），
    #     Agent 的 %f 会变成空串，因此还需要
    #         RT_KLIBC_USING_VSNPRINTF_STANDARD = y
    #     （并保持 DECIMAL/EXPONENTIAL specifiers 打开）才有完整浮点支持。
    #
    #   * pkgs/rt_vsnprintf_full 自己的 Kconfig 是 depends on RT_VER_NUM < 0x50200：
    #     RT-Thread >= 5.2 上该包无法被选中，此时只能用上面的 STANDARD = y 方案。
    #
    # 结论（auto 模式）：内核没有定义该符号 -> 选包；内核已定义 -> 不选包，
    # 并在菜单里提示是否还需要打开 STANDARD。也可以用下面的
    # PKG_AGENT_VSNPRINTF_SRC_SEL 手动强制。
    select PKG_USING_RT_VSNPRINTF_FULL if PKG_AGENT_VSNPRINTF_NEED_PKG

    default n

if PKG_USING_AGENT

    config PKG_AGENT_PATH
        string
        default "/packages/ai/Agent"

    menu "Agent Build Options"

    # ------------------------------------------------------------------
    # 隐藏判定变量：menuconfig 中不显示，但会写进 .config，便于排查
    # 「为什么这个包被/没被选中」。全部由内核符号推导，不需要人工维护。
    # ------------------------------------------------------------------

    # 内核是否已经提供 rt_vsnprintf 符号（klibc 的 std/tiny 都会定义；
    # RT_KLIBC_USING_LIBC_VSNPRINTF=y 时 klibc 不编译这两者，符号不存在）
    # 说明：RT_VER_NUM 在 4.x/5.x 都是内核自己的隐藏 hex 符号（值就是内核版本），
    # 直接读它比维护一个人工版本号可靠；未定义它的极老内核在 Kconfig 里无法与
    # 「比较结果为假」区分，因此这里不做人工兜底，需要时用 USE_PKG 强制。
    config PKG_AGENT_KLIBC_HAS_VSNPRINTF
        bool
        default y if RT_VER_NUM >= 0x40100 && !RT_KLIBC_USING_LIBC_VSNPRINTF

    # 内核提供的是否为「支持 %f/%e/%g 的完整实现」
    # （tiny 实现符号存在但不支持浮点，Agent 的 %f 会打印成空串）
    config PKG_AGENT_KLIBC_FULL_VSNPRINTF
        bool
        default y if PKG_AGENT_KLIBC_HAS_VSNPRINTF && RT_KLIBC_USING_VSNPRINTF_STANDARD && RT_KLIBC_USING_VSNPRINTF_DECIMAL_SPECIFIERS

    # pkgs/rt_vsnprintf_full 本身是否可用（其 Kconfig: depends on RT_VER_NUM < 0x50200）
    config PKG_AGENT_VSNPRINTF_PKG_USABLE
        bool
        default y if RT_VER_NUM < 0x50200

    # 最终是否需要 select pkgs/rt_vsnprintf_full
    # auto 分支只在「内核没有该符号」且「该包可用」时选；USE_PKG 是人工强制
    config PKG_AGENT_VSNPRINTF_NEED_PKG
        bool
        default y if PKG_AGENT_VSNPRINTF_USE_PKG && PKG_AGENT_VSNPRINTF_PKG_USABLE
        default y if PKG_AGENT_VSNPRINTF_AUTO && !PKG_AGENT_KLIBC_HAS_VSNPRINTF && PKG_AGENT_VSNPRINTF_PKG_USABLE


        config PKG_AGENT_RT_VERSION_MAJOR
            int "Target RT-Thread major version (informational)"
            range 3 9
            default 5
            help
                Informational: the automatic decision below reads the kernel's
                own RT_VER_NUM symbol (RT-Thread 4.x/5.x define it), so nothing
                has to be kept in sync manually.

                The real question is not the version but whether klibc defines
                rt_vsnprintf:
                  RT_KLIBC_USING_LIBC_VSNPRINTF=n : klibc compiles
                      rt_vsnprintf_std.c / rt_vsnprintf_tiny.c, which already
                      define rt_vsnprintf -> the package must NOT be selected,
                      otherwise the link fails with
                          multiple definition of `rt_vsnprintf'
                      This is true for RT-Thread >= 4.1 as well, which is why a
                      version-only check ("major < 5") selected the package
                      wrongly on 4.1.x and 5.2/5.3.
                  RT_KLIBC_USING_LIBC_VSNPRINTF=y : klibc defers to the libc
                      vsnprintf, the kernel does not define the symbol, and the
                      package can provide it (below RT-Thread 5.2 only; on 5.2+
                      libc's own vsnprintf already handles %f/%e).

                Only a kernel predating RT_VER_NUM cannot be classified
                automatically (Kconfig cannot distinguish "undefined" from
                "comparison is false"); on such a tree use
                PKG_AGENT_VSNPRINTF_USE_PKG, or enable
                PKG_USING_RT_VSNPRINTF_FULL directly in its own menu.

        choice PKG_AGENT_VSNPRINTF_SRC_SEL
            prompt "Full vsnprintf source"
            default PKG_AGENT_VSNPRINTF_AUTO
            help
                Source of the full-featured vsnprintf (used for %f/%e and long integers).

            config PKG_AGENT_VSNPRINTF_AUTO
                bool "auto - decide by klibc capability and RT-Thread version (recommended)"
                help
                    Kernel already defines rt_vsnprintf
                    (RT_VER_NUM >= 0x40100 and RT_KLIBC_USING_LIBC_VSNPRINTF=n)
                        -> use the kernel implementation, never select the package
                    Kernel does not define it
                    (RT_KLIBC_USING_LIBC_VSNPRINTF=y) and RT-Thread < 5.2
                        -> select PKG_USING_RT_VSNPRINTF_FULL
                    RT-Thread >= 5.2
                        -> the package is unavailable (its own Kconfig says
                           "depends on RT_VER_NUM < 0x50200"), nothing is
                           selected. That is fine either way: with klibc
                           (RT_KLIBC_USING_LIBC_VSNPRINTF=n) the kernel std
                           implementation handles %f when
                           RT_KLIBC_USING_VSNPRINTF_STANDARD=y, and with
                           RT_KLIBC_USING_LIBC_VSNPRINTF=y the libc vsnprintf
                           does.

                    Note: the kernel's tiny implementation
                    (RT_KLIBC_USING_VSNPRINTF_STANDARD=n, the 32-bit default!)
                    defines the symbol but prints nothing for %f/%e/%g, so the
                    agent's float output would be silently empty even though
                    the symbol exists - the menu shows a WARNING line for that
                    case. Fix it with RT_KLIBC_USING_VSNPRINTF_STANDARD=y
                    (Kernel -> klibc -> rt_vsnprintf options).

            config PKG_AGENT_VSNPRINTF_USE_KLIB
                bool "kernel klibc only - never select rt_vsnprintf_full"
                help
                    Use this when you are sure the kernel already provides a full
                    rt_vsnprintf (RT_KLIBC_USING_VSNPRINTF_STANDARD=y on RT-Thread 5.x,
                    or RT_KLIBC_USING_LIBC_VSNPRINTF=y with newlib).

            config PKG_AGENT_VSNPRINTF_USE_PKG
                bool "pkgs/rt_vsnprintf_full - force select"
                help
                    Force using pkgs/rt_vsnprintf_full. You MUST also stop the kernel
                    from defining rt_vsnprintf, i.e. set
                        RT-Thread Kernel -> klibc -> RT_KLIBC_USING_LIBC_VSNPRINTF = y
                    otherwise the link fails with
                        multiple definition of `rt_vsnprintf'
                    The package itself is only offered on RT-Thread < 5.2
                    (depends on RT_VER_NUM < 0x50200), so on 5.2 and later this
                    choice has no effect and the menu shows that - use
                    RT_KLIBC_USING_VSNPRINTF_STANDARD=y (klibc) or
                    RT_KLIBC_USING_LIBC_VSNPRINTF=y (libc) instead.
        endchoice

        # 下面是让 menuconfig 直接显示自动判定结果的提示行（按依赖显示）
        comment "vsnprintf: kernel klibc provides rt_vsnprintf -> pkgs/rt_vsnprintf_full NOT selected"
            depends on PKG_AGENT_KLIBC_HAS_VSNPRINTF && !PKG_AGENT_VSNPRINTF_NEED_PKG

        comment "vsnprintf: WARNING klibc vsnprintf has no %f - enable RT_KLIBC_USING_VSNPRINTF_STANDARD (or use the package)"
            depends on !PKG_AGENT_KLIBC_FULL_VSNPRINTF && !PKG_AGENT_VSNPRINTF_NEED_PKG

        comment "vsnprintf: pkgs/rt_vsnprintf_full IS selected (kernel has no rt_vsnprintf)"
            depends on PKG_AGENT_VSNPRINTF_NEED_PKG

        comment "vsnprintf: rt_vsnprintf_full unavailable on RT-Thread >= 5.2 - set RT_KLIBC_USING_VSNPRINTF_STANDARD=y"
            depends on PKG_AGENT_VSNPRINTF_USE_PKG && !PKG_AGENT_VSNPRINTF_PKG_USABLE

    endmenu

    menu "Model & Endpoint"
        config PKG_AGENT_API_KEY
            string "LLM service API Key"
            default "sk-**-**"
            help
                API key for accessing large-model LLM service.

        config PKG_AGENT_MODEL_NAME
            string "Target LLM model name"
            default "deepseek-flash"
            help
                Specify the target LLM model identifier.

        # LLM 协议选择：OpenAI 的 /chat/completions 与 Anthropic 的 /v1/messages
        choice PKG_AGENT_API_PROTOCOL_SEL
            prompt "LLM API protocol"
            default PKG_AGENT_API_PROTOCOL_OPENAI
            help
                Wire format of the LLM service.
                OpenAI: POST /chat/completions, Bearer token, delta-based SSE.
                Anthropic: POST /v1/messages, x-api-key header, event-based SSE.
                This choice only sets the default protocol. A running agent can
                switch protocol through agent_config_set_protocol().
                The Anthropic options below only show up when Anthropic is
                picked here.

            config PKG_AGENT_API_PROTOCOL_OPENAI
                bool "OpenAI"

            config PKG_AGENT_API_PROTOCOL_ANTHROPIC
                bool "Anthropic"
        endchoice

        config PKG_AGENT_API_BASE_URL_OPENAI
            string "OpenAI base URL"
            default "https://api.deepseek.com"
            help
                Service root of the OpenAI wire format, without path. The
                framework appends /chat/completions when it sends a request.
                https://api.deepseek.com/chat/completions
                -> base URL: https://api.deepseek.com

        config PKG_AGENT_API_BASE_URL_ANTHROPIC
            string "Anthropic base URL"
            default "https://api.deepseek.com/anthropic"
            help
                Service root of the Anthropic wire format, without path. The
                framework appends /v1/messages when it sends a request.
                https://api.deepseek.com/anthropic/v1/messages
                -> base URL: https://api.deepseek.com/anthropic

        config PKG_AGENT_ANTHROPIC_VERSION
            string "Anthropic API version header"
            depends on PKG_AGENT_API_PROTOCOL_ANTHROPIC
            default "2023-06-01"
            help
                Value of the anthropic-version request header.
                This option only shows up when the protocol is Anthropic.

        config PKG_AGENT_ANTHROPIC_MAX_TOKENS
            int "Anthropic max output tokens"
            depends on PKG_AGENT_API_PROTOCOL_ANTHROPIC
            default 4096
            range 256 32768
            help
                Upper bound of the max_tokens field of an Anthropic request.
                The service rejects a value larger than the model's own output
                limit, so the value sent is min(request value, this cap).
                This option only shows up when the protocol is Anthropic.

        endmenu

    menu "Multimodal"

        # Multimodal enable/disable choice (mode 开关)
        choice PKG_AGENT_MULTIMODAL_MODE_SEL
            prompt "Multimodal feature switch"
            default PKG_AGENT_MULTIMODAL_DISABLE
            help
                Enable or disable agent multimodal(image/file/audio) capability.

            config PKG_AGENT_MULTIMODAL_DISABLE
                bool "Disable multimodal function"

            config PKG_AGENT_MULTIMODAL_ENABLE
                select WEBCLIENT_USING_FILE_DOWMLOAD
                bool "Enable multimodal function"
                help
                Enable image parsing and file upload/download for agent.
        endchoice

        if PKG_AGENT_MULTIMODAL_ENABLE
            config PKG_AGENT_WEB_SERVER_URL
                string "Web server URL"
                default "http://10.0.2.2:8000"
                help
                    板端访问 web 服务器的地址，只填到端口，不要带路径。
                    接口路径由板端自己拼：
                      上传     <地址>/upload
                      下载     <地址>/download/<file_id>
                      语音识别 <地址>/stt
                      语音合成 <地址>/tts
                    QEMU 里的板子访问宿主机用 http://10.0.2.2:8000；
                    真板子填局域网地址，例如 http://192.168.1.10:8000；
                    走内网穿透填公网域名，例如 https://files.l2.bb1a.cn。
                    注意：云端模型按同一个地址取文件，
                    所以这个地址必须公网可达。

            menu "File Server"
                config PKG_AGENT_FILE_OP_THREAD_SIZE
                    int "File operation thread stack size"
                    default 4096
                    range 2048 16384
                    help
                        Stack size for agent file-operation worker thread.

            endmenu

            menu "Speech"

                menu "STT"
                    choice PKG_AGENT_STT_MODE_SEL
                        prompt "Enable STT for communication by audio"
                        default PKG_AGENT_STT_ENABLE
                        
                        config PKG_AGENT_STT_ENABLE
                            bool "Enable STT"
                        config PKG_AGENT_STT_DISABLE
                            bool "Disable STT"
                    endchoice

                    # STT 接口地址由 PKG_AGENT_WEB_SERVER_URL 拼出：<地址>/stt
                endmenu

                menu "TTS"
                    choice PKG_AGENT_TTS_MODE_SEL
                        prompt "Enable TTS for communication by audio"
                        default PKG_AGENT_TTS_ENABLE

                        config PKG_AGENT_TTS_ENABLE
                            bool "Enable TTS"
                        config PKG_AGENT_TTS_DISABLE
                            bool "Disable TTS"
                    endchoice

                    if PKG_AGENT_TTS_ENABLE
                        # TTS 接口地址由 PKG_AGENT_WEB_SERVER_URL 拼出：<地址>/tts

                        config PKG_AGENT_TTS_SAVE_FILE
                            string "Synthesized WAV save path"
                            default "/tts.wav"
                            help
                                合成结果落盘的完整路径，必须是可写文件系统。
                                根目录挂 romfs 的板子要换到 /sdcard 或 /flash，
                                例如 "/sdcard/tts.wav"。
                                msh_agent_tts 用 -o 可以临时覆盖这个路径。
                                名字不能以 _PATH 结尾：RT-Thread 用 PKG_*_PATH
                                记录软件包安装路径，mk_rtconfig 会把它从
                                rtconfig.h 里删掉。

                        config PKG_AGENT_TTS_AUTO_PLAY
                            depends on PKG_AGENT_DRIVER_AUDIO
                            bool "Auto play the answer by voice"
                            default n
                            help
                                把每一轮回复文本交给后台线程合成并播放。
                                需要板上注册了 sound 设备，且 TTS 服务端常驻。
                                合成一句要 3 s～5 s（冷启动可到 180 s），
                                只在串行通道里逐条回答时才适合打开。
                    endif
                endmenu

            endmenu
        endif

    endmenu

    # 音频驱动与「多模态」无关，从多模态开关里移出来，避免必须打开多模态才能用音频
    menu "Audio Driver"
            config PKG_AGENT_DRIVER_AUDIO
                select PKG_USING_WAVPLAYER
                select PKG_WP_USING_RECORD
                select RT_USING_AUDIO
                bool "Enable Agent Driver Audio"
                help
                    Enable the agent audio driver (wav play/record).

                    NOTES on the selects:
                      * PKG_WP_USING_RECORD is the real wavplayer option name
                        (PKG_WP_USINGRECORD does not exist and was a silent no-op).
                      * RT_USING_AUDIO comes from the Audio framework, so it is
                        portable across BSPs; the previous
                        "select BSP_USING_AUDIO" was BSP specific and does not
                        exist in every BSP (this BSP uses BSP_DRV_AUDIO, which
                        already selects RT_USING_AUDIO) - enable your BSP's own
                        audio/sound driver first.
                      * This option used to be nested inside
                        PKG_AGENT_MULTIMODAL_ENABLE, so the audio driver could
                        not be enabled without multimodal; it is now independent.
        endmenu

    menu "Buffer & Length Configuration"
        config PKG_AGENT_WEB_SOCKET_BUFSZ
            int "Webclient session buffer size"
            default 2048
            range 512 8192
            help
                Send/receive buffer size for webclient http session.

        config PKG_AGENT_RESP_BUFSZ
            int "HTTP response temporary buffer size"
            default 2048
            range 512 8192

        config PKG_AGENT_MAX_REASONING_LEN
            int "Max reasoning text buffer length"
            default 2048
            range 256 8192
            help
                Upper limit buffer length for LLM reasoning content.

        config PKG_AGENT_MAX_CONTENT_LEN
            int "Max chat message content length"
            default 2048
            range 256 8192
            help
                Maximum payload length of single chat message.

        config PKG_AGENT_STREAM_LINE_BUFSZ
            int "SSE streaming parse line buffer size"
            default 1024
            range 512 8192
            help
                Line buffer for parsing SSE streaming chunk response.
                NOTE: keep >= 1024. A single SSE chunk carrying tool_calls is
                about 310+ bytes, and an over-long line is discarded, which makes
                the framework miss tool calls (model looks like it never calls tools).

        config PKG_AGENT_MAX_TOOL_ARG_LEN
            int "Max tool-call JSON argument length"
            default 1024
            range 256 8192
            help
                Maximum buffer length for tool call JSON arguments.
                NOTE: keep >= 512; streaming arguments are appended fragment by
                fragment and are dropped once this limit is exceeded.

        config PKG_AGENT_MESSAGE_TRIM
            int "History message compression threshold"
            default 6
            range 2 64
            help
                Compress when history exceeds N messages (excluding the system
                prompt and rolling summary). Keep at least N/2 recent messages,
                expanding to whole user turns so tool calls stay with results.
                Older turns and the previous summary are summarized by the LLM
                in one extra request. Replace only with a complete, shorter
                summary; on failure keep the original history without deletion.
                A single long turn is kept intact even if it exceeds N.
    endmenu

